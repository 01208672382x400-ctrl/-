# Supabase
SUPABASE_URL=https://fdvgpdfesvigtvmzjhnt.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY
ADMIN_USER_IDS=UUID_OF_ADMIN_USER
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# LiveKit
LIVEKIT_URL=wss://YOUR_PROJECT.livekit.cloud
LIVEKIT_API_KEY=YOUR_LIVEKIT_API_KEY
LIVEKIT_API_SECRET=YOUR_LIVEKIT_API_SECRET

# Public URL used by Capacitor/webview build
# Set this to the deployed HTTPS URL of this Next.js app, not the Supabase URL.
NEXT_PUBLIC_APP_URL=https://YOUR-DEPLOYED-APP.example.com

# Public browser values
NEXT_PUBLIC_SUPABASE_URL=https://fdvgpdfesvigtvmzjhnt.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY

# Optional production admin allowlist (server-side only)
# ADMIN_USER_IDS=uuid1,uuid2
